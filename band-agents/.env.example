# Copy to .env (local only, gitignored). NEVER commit real keys.
BAND_REST_URL=https://app.band.ai
BAND_WS_URL=wss://app.band.ai/api/v1/socket/websocket

# OpenCode server (local)
OPENCODE_BASE_URL=http://127.0.0.1:4096

# Model overrides (confirm via `opencode models`)
# The three keys below are the adapter roles, not the seat names. The seats are
# factory-architect-df, factory-coder-df and factory-tester-df; see agent_config.yaml.
# Architect: muse-spark-1.3-contributor-free (fallback space-bunny-free khi 429, accepted)
OPENCODE_MODEL_COORDINATOR=muse-spark-1.3-contributor-free
OPENCODE_PROVIDER_COORDINATOR=opencode
OPENCODE_MODEL_COORDINATOR_FALLBACK=space-bunny-free
COORDINATOR_USE_FALLBACK=0
# Coder: muse-spark-1.3-contributor-free (fallback nemotron-3-ultra-free khi 429, accepted)
OPENCODE_MODEL_IMPLEMENTER=muse-spark-1.3-contributor-free
OPENCODE_PROVIDER_IMPLEMENTER=opencode
OPENCODE_MODEL_IMPLEMENTER_FALLBACK=nemotron-3-ultra-free
IMPLEMENTER_USE_FALLBACK=0
# Reviewer primary: gemini-3.8-flash, verified working 2026-10-01; 2.0 and 2.5 are rejected for a
# newer key. The OpenCode server needs GOOGLE_GENERATIVE_AI_API_KEY exported before it starts.
# Fallback, accepted: REVIEWER_USE_FALLBACK=1 -> OpenCode nemotron-3-ultra-free, a different
# model from the implementer's so independence survives a quota outage without blocking the run.
GEMINI_MODEL_ID=gemini-3.8-flash
GOOGLE_GENERATIVE_AI_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL_ID=gpt-4o-mini
REVIEWER_USE_FALLBACK=0
OPENCODE_PROVIDER_REVIEWER=opencode
OPENCODE_MODEL_REVIEWER=nemotron-3-ultra-free
